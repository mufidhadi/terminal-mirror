# Relay Server Configuration
# In production, bind RELAY_BIND_IP to your private VPN interface (e.g. ZeroTier/WireGuard IP)
RELAY_BIND_IP=127.0.0.1
RELAY_PORT=8888
RELAY_AUTH_TOKEN=generate_a_secure_random_token_here

# Anti-Abuse & Resource Limits
MAX_CONN_PER_MIN=60
MAX_PAYLOAD_BYTES=65536
STALE_SESSION_TIMEOUT_SECS=300

# Host Agent Configuration (macOS / Windows)
RELAY_SERVER_URL=ws://127.0.0.1:8888/ws
HOST_ID=my-workstation
DEFAULT_SHELL=/bin/zsh

# Logging
RUST_LOG=info
